# Codex exec policy rules for high-risk commands.
#
# These rules route high-risk commands to the configured approval reviewer.
# The default profile uses auto-review. The everyday dangerous-command guard
# lives in the shared agent guideline deployed as ~/.codex/AGENTS.md
# (canonical source: templates/CLAUDE.md), not here.

prefix_rule(
  pattern = ["git", "push", "--force"],
  decision = "prompt",
  justification = "Force-pushing rewrites remote history; require approval review.",
)

prefix_rule(
  pattern = ["git", "push", "--force-with-lease"],
  decision = "prompt",
  justification = "Force-pushing rewrites remote history; require approval review.",
)

prefix_rule(
  pattern = ["git", "reset", "--hard"],
  decision = "prompt",
  justification = "Hard reset discards local work; require approval review.",
)

prefix_rule(
  pattern = ["rm", "-rf"],
  decision = "prompt",
  justification = "Recursive deletion outside the sandbox requires approval review.",
)

prefix_rule(
  pattern = ["gh", "pr", "create"],
  decision = "prompt",
  justification = "Creating a pull request writes to GitHub; require approval review.",
)

prefix_rule(
  pattern = ["gh", "issue", "create"],
  decision = "prompt",
  justification = "Creating an issue writes to GitHub; require approval review.",
)

prefix_rule(
  pattern = ["gh", "release"],
  decision = "prompt",
  justification = "Release operations write externally; require approval review.",
)
