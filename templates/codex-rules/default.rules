# Codex exec policy rules for high-risk commands.
#
# These rules route high-risk commands to explicit prompt approval whenever an
# approval path is active. The everyday dangerous-command guard lives in
# AGENTS.md, not here.

prefix_rule(
  pattern = ["git", "push", "--force"],
  decision = "prompt",
  justification = "Force-pushing rewrites remote history; require explicit user approval.",
)

prefix_rule(
  pattern = ["git", "push", "--force-with-lease"],
  decision = "prompt",
  justification = "Force-pushing rewrites remote history; require explicit user approval.",
)

prefix_rule(
  pattern = ["git", "reset", "--hard"],
  decision = "prompt",
  justification = "Hard reset discards local work; require explicit user approval.",
)

prefix_rule(
  pattern = ["rm", "-rf"],
  decision = "prompt",
  justification = "Recursive deletion outside the sandbox must be explicitly approved.",
)

prefix_rule(
  pattern = ["gh", "pr", "create"],
  decision = "prompt",
  justification = "Creating a pull request writes to GitHub; require explicit user approval.",
)

prefix_rule(
  pattern = ["gh", "issue", "create"],
  decision = "prompt",
  justification = "Creating an issue writes to GitHub; require explicit user approval.",
)

prefix_rule(
  pattern = ["gh", "release"],
  decision = "prompt",
  justification = "Release operations write externally; require explicit user approval.",
)
